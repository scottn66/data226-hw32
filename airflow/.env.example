# Copy to airflow/.env and fill in. Never commit airflow/.env.
# Airflow connection used by every HW 3.2 DAG (key-pair auth; include/rsa_key.p8 is gitignored).
# Loaded by `astro dev start` / `astro dev restart`.
AIRFLOW_CONN_SNOWFLAKE_CONN='{"login": "<SNOWFLAKE_USER>", "schema": "RAW", "conn_type": "snowflake", "extra": {"account": "<ACCOUNT_IDENTIFIER e.g. orgname-accountname>", "warehouse": "hw32_wh", "database": "HW32", "role": "ACCOUNTADMIN", "authenticator": "SNOWFLAKE_JWT", "private_key_file": "/usr/local/airflow/include/rsa_key.p8"}}'
