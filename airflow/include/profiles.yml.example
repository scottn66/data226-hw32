# Copy to airflow/include/profiles.yml (gitignored). Cosmos reads it via hw32_common.PROFILES.
hw32_dbt:
  target: prod
  outputs:
    prod:                       # production: built by the daily pipeline
      &prod
      type: snowflake
      account: <ACCOUNT_IDENTIFIER e.g. orgname-accountname>
      user: <SNOWFLAKE_USER>
      private_key_path: /usr/local/airflow/include/rsa_key.p8
      role: ACCOUNTADMIN
      warehouse: hw32_wh
      database: HW32
      schema: ANALYTICS
      threads: 4
    dev:                        # 9.1: zero-copy clone of prod
      <<: *prod
      database: HW32_DEV
    proto:                      # 9.3: prototype schema cloned from HW32.ANALYTICS
      <<: *prod
      schema: PROTOTYPE
